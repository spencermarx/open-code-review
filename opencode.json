{
  "$schema": "https://opencode.ai/config/v1/schema.json",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "servers": {
      "claude-flow": {
        "type": "remote",
        "command": [
          "npx",
          "-y",
          "ruflo@latest",
          "mcp",
          "start"
        ],
        "environment": {
          "npm_config_update_notifier": "false",
          "CLAUDE_FLOW_MODE": "v3",
          "CLAUDE_FLOW_HOOKS_ENABLED": "true",
          "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
          "CLAUDE_FLOW_MAX_AGENTS": "15",
          "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
        },
        "disabled": true
      },
      "ruflo": {
        "type": "remote",
        "command": [
          "npx",
          "-y",
          "ruflo@latest",
          "mcp",
          "start"
        ],
        "environment": {
          "npm_config_update_notifier": "false",
          "CLAUDE_FLOW_MODE": "v3",
          "CLAUDE_FLOW_HOOKS_ENABLED": "true",
          "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
          "CLAUDE_FLOW_MAX_AGENTS": "15",
          "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
        },
        "disabled": true
      }
    }
  },
  "agents": {},
  "commands": ".opencode/commands",
  "skills": [
    ".claude/skills"
  ],
  "permissions": {
    "*": "deny"
  },
  "policies": {},
  "plugins": [],
  "model": {
    "default_model": "qwen3.6:35b-mlx",
    "provider": "ollama"
  },
  "default_agent": {
    "name": "ocr",
    "model": "qwen3.6:35b-mlx"
  }
}
